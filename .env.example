# =============================================================
# SLM Project — .env.example
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# =============================================================

# --- Project Root (set automatically by scripts, override if needed) ---
# SLM_PROJECT_ROOT=/path/to/project

# --- Random Seeds (for reproducibility) ---
SLM_SEED=42

# --- Web Search (Phase 22) ---
# SerpAPI key — get one at https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here

# DuckDuckGo (no key needed, but rate-limited)
# DUCKDUCKGO_MAX_RESULTS=5

# --- HuggingFace (for gated datasets/models) ---
# HF_TOKEN=your_huggingface_token_here

# --- Logging ---
SLM_LOG_LEVEL=INFO
SLM_LOG_DIR=logs

# --- Paths (override defaults in configs/) ---
# SLM_DATA_DIR=data
# SLM_CHECKPOINT_DIR=checkpoints
# SLM_TOKENIZER_DIR=tokenizer/artifacts
