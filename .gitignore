# =============================================================
# SLM Project — .gitignore
# =============================================================

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
.env/

# --- Environment Variables (SECRETS — never commit) ---
.env
.env.local
.env.*.local

# --- Python Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# --- Distribution / Build ---
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# --- Testing / Coverage ---
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# --- Type Checking ---
.mypy_cache/
.dmypy.json

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Large Data Files (track manifests, not raw data) ---
data/raw/**
data/interim/**
data/processed/**
data/validation/*.json
!data/validation/.gitkeep
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# --- Model Checkpoints (large binary files) ---
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin

# --- Tokenizer Artifacts (generated, not source) ---
tokenizer/artifacts/
*.model
*.vocab

# --- Logs ---
logs/
*.log

# --- OS Artifacts ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- Temporary Files ---
tmp/
temp/

# --- NVIDIA Profiling ---
*.nsys-rep
*.ncu-rep

# --- Experiment Tracking ---
wandb/
mlruns/
mlartifacts/

# --- HuggingFace Cache (large) ---
.cache/

# --- Profiling ---
*.prof
